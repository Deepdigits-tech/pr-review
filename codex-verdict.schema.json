{
  "type": "object",
  "additionalProperties": false,
  "required": ["verdicts", "missed", "overall"],
  "properties": {
    "verdicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "verdict", "reason"],
        "properties": {
          "id": {"type": "integer"},
          "verdict": {"type": "string", "enum": ["agree", "disagree", "unsure"]},
          "reason": {"type": "string"}
        }
      }
    },
    "missed": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "line", "severity", "body"],
        "properties": {
          "path": {"type": "string"},
          "line": {"type": "integer"},
          "severity": {"type": "string", "enum": ["blocker", "should-fix", "nit"]},
          "body": {"type": "string"}
        }
      }
    },
    "overall": {"type": "string"}
  }
}
